# These fake values only let static checks and builds initialize clients.
# This repository is not a self-hosting guide.
# OAuth, billing, cron, admin, and destructive-debug configuration is managed
# privately and intentionally omitted.

NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SITE_LOCKED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chrome Web Store listing. Setting this switches on three surfaces at
# once: the welcome install step, the dashboard nudge, and the hard
# extension wall around the signed-in app. Leaving it unset keeps all
# three dark. Build-time value (NEXT_PUBLIC_): changing it needs a rebuild.
# NEXT_PUBLIC_EXTENSION_STORE_URL=
# DataFast website API key (df_…). The tracking script in the root
# layout does not need this; the leaderboard visitor ticker does.
# DATAFAST_API_KEY=
# Optional override for the ticker's "see stats" link. Defaults to
# https://datafa.st/share/6a87f87b9edaa5d87fb85c63 (public dashboard).
# NEXT_PUBLIC_DATAFAST_STATS_URL=
