# ===========================================
# Cribble Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env or .env.local to git

# ----- Supabase (Required) -----
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Database (Required) -----
# Get from: Supabase → Project Settings → Database → Connection String
DATABASE_URL=

# ----- X (Twitter) OAuth (Required for X login) -----
# Set up at: https://developer.x.com → Projects & Apps → User authentication settings
# Type of App: Web App (confidential client) with OAuth 2.0 enabled
# Callback URL: http://localhost:3000/api/auth/twitter/callback
# Signups stay invite-gated: X login only works for beta members / valid keys
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# ----- GitHub OAuth (Required for GitHub login) -----
# Set up at: https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ----- NextAuth (Required) -----
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ----- App URL (Required) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# ----- Security (Required in production) -----
# Generate: openssl rand -base64 32 (must be 32+ chars in production)
CRON_SECRET=

# Dangerous data-debug APIs are 404 by default, even in `next dev`.
# Enable only for a short local maintenance session; never enable on Vercel.
ENABLE_DANGEROUS_DEBUG_ROUTES=false
# Required while enabled (no built-in fallback values).
# Generate each independently: openssl rand -hex 32
DEBUG_RESET_TOKEN=
DEBUG_CLEANUP_TOKEN=

# ----- Admin (Required) -----
# Owner-level breakglass allowlist (GitHub usernames, comma-separated).
# Accounts listed here always resolve to the 'owner' staff role, so the
# operator can never be locked out of /admin. Moderators are promoted
# from the panel itself (users.staff_role).
ADMIN_USERNAMES=your-username

# ----- Polar.sh payments (Cribble Pro + Plate Shop) -----
# Set POLAR_ACCESS_TOKEN, then `npm run setup:polar -- --write-env` provisions
# everything below automatically (see README → Monetization).
# Organization access token: https://polar.sh → Settings → Developers
# (use https://sandbox.polar.sh while testing)
POLAR_ACCESS_TOKEN=
# 'sandbox' (default) or 'production' — must match where the token was made
POLAR_SERVER=sandbox
# Secret from the webhook endpoint config (point it at /api/webhooks/polar)
POLAR_WEBHOOK_SECRET=
# Product IDs from the Polar dashboard. Display prices live in the app's
# plate catalog; the amounts actually charged are configured on these
# Polar products.
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
# JSON map of plateId -> Polar product id,
# e.g. {"synthwave-grid":"11111111-2222-3333-4444-555555555555"}
# Each plate product in Polar must also carry `plate_id` metadata matching
# the catalog id — the webhook uses it to grant the plate on order.paid.
# Unpriced plates (champions-gold, pro exclusives) are never sold:
# the checkout route refuses them even if they appear in this map.
POLAR_PLATE_PRODUCT_MAP=
# Optional: Polar discount id (create a 25% discount) auto-applied to plate checkouts for Pro members
POLAR_DISCOUNT_PRO_PLATES=

# ----- Klipy GIF search (Banner Studio) -----
# Powers the GIF picker for Pro animated banners. Free API — sign up at
# https://partner.klipy.com and create a platform to get a key. Test keys
# are rate-limited to 100 calls/min; request a production key in the same
# panel before launch. Leave unset to disable the GIF tab (the picker
# shows "GIF SEARCH IS OFFLINE"; URL banners keep working).
KLIPY_API_KEY=

# ----- Feature Flags -----
# Set to true to hide unfinished routes behind a redirect
NEXT_PUBLIC_SITE_LOCKED=false

# ----- Optional -----
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
